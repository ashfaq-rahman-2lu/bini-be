DATABASE_URL=postgresql+psycopg://bini:bini_local_only@127.0.0.1:55433/bini
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Set your single account's password and a random signing secret of at least 32 characters.
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=

# Local HTTP only. Keep true (the default) on Railway/HTTPS.
AUTH_COOKIE_SECURE=false

# JSON request timings are always written to stdout. Optional Better Stack sink:
LOG_ENVIRONMENT=development
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTION_URL=
